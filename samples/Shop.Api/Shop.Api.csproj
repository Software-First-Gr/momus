<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shop.Api</RootNamespace>
    <AssemblyName>Shop.Api</AssemblyName>

    <!-- A demo, not a product: never packed, never published to NuGet. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The demo's deploy. Compose passes these as build arguments, so a new version of the shop is
       one command: a real application gets its version from its own build, and a version turning
       up for the first time is all Momus needs to call it a deploy. ShopSlowBuild compiles in the
       regression the demo exists to catch (CartTotalsRefresher). -->
  <PropertyGroup>
    <Version Condition="'$(ShopVersion)' != ''">$(ShopVersion)</Version>
    <DefineConstants Condition="'$(ShopSlowBuild)' == 'true'">$(DefineConstants);SLOW_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project reference here, a PackageReference to Momus.Client in a real application. -->
    <ProjectReference Include="..\..\src\Momus.Client\Momus.Client.csproj" />
  </ItemGroup>

</Project>
