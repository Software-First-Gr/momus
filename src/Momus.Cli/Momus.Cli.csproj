<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Published as the `momus` dotnet global tool: dotnet tool install -g Momus -->
  <PropertyGroup Label="Package">
    <PackageId>Momus</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>momus</ToolCommandName>
    <Description>Momus command line. `momus scan` connects to PostgreSQL or SQL Server, runs read-only diagnostic checks against the engine's own statistics views and prints prioritized findings with evidence. Exit code 3 on High or Critical findings, for CI. JSON export for downstream and AI consumption.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Momus.Core\Momus.Core.csproj" />
    <ProjectReference Include="..\Momus.Postgres\Momus.Postgres.csproj" />
    <ProjectReference Include="..\Momus.SqlServer\Momus.SqlServer.csproj" />
  </ItemGroup>

</Project>
