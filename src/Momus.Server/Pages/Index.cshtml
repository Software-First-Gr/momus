@page
@model IndexModel
@{
    ViewData["Title"] = "Momus";
    ViewData["Tab"] = "fix";
    ViewData["HeaderStatus"] = Model.HeaderStatus;
    ViewData["TargetId"] = Model.Selected?.Id;
}

@if (Model.Targets.Count == 0)
{
    <section>
        <h1>Nothing to scan yet</h1>
        <p class="lede">
            Momus needs one thing: a connection string to a database it may read. It only ever reads
            the engine's own statistics views, so a read-only user is enough.
        </p>

        <p class="small muted">Point it at a database from the command line —</p>
        <pre>momus serve --target postgres:"Host=localhost;Username=momus;Database=shop"</pre>

        <p class="small muted">— or from the environment, which is what the container expects:</p>
<pre>docker run -d -p 127.0.0.1:@(Model.Port):@(Model.Port) -v momus-data:/data \
  -e MOMUS_TARGETS__0__PROVIDER=postgres \
  -e MOMUS_TARGETS__0__CONNECTIONSTRING="Host=host.docker.internal;Username=momus;Database=shop" \
  momus</pre>

        <p class="small muted">— or just <a href="/settings">add one here</a>.</p>
    </section>
}
else
{
    <section>
        <div style="display:flex;gap:14px;align-items:baseline;flex-wrap:wrap">
            <div>
                <h1>Fix first</h1>
                <p class="lede" style="margin:0">
                    Ordered by how much it is costing you, not by how alarming it sounds: severity,
                    times the share of traffic that hits it, times how recently it started.
                </p>
            </div>
            <div class="grow" style="flex:1"></div>

            @if (Model.Targets.Count > 1)
            {
                <form method="get" style="display:flex;gap:8px;align-items:center">
                    <select name="target" onchange="this.form.submit()" style="width:auto">
                        @foreach (var target in Model.Targets)
                        {
                            <option value="@target.Id" selected="@(target.Id == Model.Selected!.Id)">@target.Name</option>
                        }
                    </select>
                </form>
            }
        </div>

        @if (Model.Top.Count == 0)
        {
            <p class="small" style="margin-top:16px">
                <span class="pill ok">NOTHING TO REPORT</span>
                <span class="muted">
                    @if (Model.App is null)
                    {
                        <text>
                            The database side is running. The insights that need both halves — an N+1,
                            a query mapped to a line of code, a regression since a deploy — need an
                            application to report too. <a href="/queries">Three lines to fix that.</a>
                        </text>
                    }
                    else
                    {
                        <text>Both halves are reporting and neither has anything to complain about.</text>
                    }
                </span>
            </p>
        }

        @foreach (var card in Model.Top)
        {
            <partial name="_InsightCard" model="card" />
        }

        @if (Model.TotalInsights > Model.Top.Count)
        {
            <p class="small muted" style="margin-top:14px">
                <a href="/insights">All @Model.TotalInsights insights →</a>
            </p>
        }
    </section>
}
