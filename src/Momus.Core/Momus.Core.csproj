<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted because Momus.Client links against it and has to live inside other
         people's applications, which are not all on the newest runtime. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Momus.Core</PackageId>
    <Description>Momus collector core: the scan engine, the diagnostic-check contract and the Finding model. Point Momus at a database and it tells you what is wrong, as structured, prioritized findings. Providers: Momus.Postgres, Momus.SqlServer. CLI: Momus.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

</Project>
